{
  "version": "1.18.15",
  "upstream": "https://github.com/anomalyco/opencode",
  "compatibility": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0",
    "platforms": ["linux", "darwin", "win32"],
    "architectures": ["x64", "arm64"]
  },
  "patches": [
    {
      "file": "001-parsers-config.patch",
      "target": "packages/tui/src/parsers-config.ts",
      "description": "在 OPENCODE_ONPREM_DIR 已设置时，将 tree-sitter wasm 和 query 的远程 URL 映射为本地路径"
    },
    {
      "file": "002-npm-onprem-gate.patch",
      "target": "packages/core/src/npm.ts",
      "description": "新增 findPackageDir() 函数（用 npa 解析 git URL/@latest 等格式提取包名），onprem 模式下阻断 npm 网络安装"
    },
    {
      "file": "003-file-type-deps.patch",
      "target": "package.json",
      "description": "添加 file-type devDependency，用于打包时 MIME 探测"
    },
    {
      "file": "004-eslint-onprem.patch",
      "target": "packages/opencode/src/lsp/server.ts",
      "description": "onprem 模式下将 vscode-eslint LSP server 路径重定向到 bundle 内 assets/eslint/vscode-eslint（构建机预编译，随 bundle 离线分发），并在 spawn 时注入 NODE_PATH 指向 bundle 预置的 eslint 本体 (assets/npm/eslint)"
    }
  ],
  "assets": {
    "tree_sitter_wasm": 31,
    "tree_sitter_queries": "~50 files",
    "ripgrep": "15.1.0",
    "github_lsp": 7,
    "eslint_lsp": "vscode-eslint (main 分支源码编译, 与原版下载行为一致) + eslint 本体 (npm)",
    "npm_packages": 13,
    "extra_plugins": ["opencode-anthropic-auth", "oh-my-openagent", "oh-my-opencode-slim", "superpowers", "@tarquinen/opencode-dcp", "opencode-supermemory", "opencode-visual-cache"],
    "models_catalog": "models.dev/api.json snapshot"
  },
  "env_vars": {
    "OPENCODE_ONPREM_DIR": "bundle 根目录路径（由 env.sh 自动设置）",
    "OPENCODE_DISABLE_AUTOUPDATE": "禁用自动更新",
    "OPENCODE_DISABLE_MODELS_FETCH": "禁用模型列表获取",
    "OPENCODE_DISABLE_LSP_DOWNLOAD": "禁用 LSP 自动下载",
    "OPENCODE_MODELS_PATH": "预下载的 models catalog 文件路径（由 env.sh 自动设置）"
  },
  "build": {
    "cli_entry": "packages/opencode",
    "cli_build_cmd": "bun run build --single",
    "desktop_prebuild_cmd": "bun run prebuild",
    "desktop_build_cmd": "bun run build",
    "desktop_package_cmd": "npx electron-builder --linux --dir --config electron-builder.config.ts"
  }
}
